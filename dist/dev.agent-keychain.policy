<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>agent-keychain</vendor>

  <action id="dev.agent-keychain.read">
    <description>Give a secret to a program</description>
    <message>"$(caller)" wants the secret "$(secret)"</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <!-- Lets the daemon's user ask polkit about other users' processes. -->
    <annotate key="org.freedesktop.policykit.owner">unix-user:agent-keychain</annotate>
  </action>

  <action id="dev.agent-keychain.allow">
    <description>Let a program read secrets without asking each time</description>
    <message>"$(caller)" wants "$(secret)" without asking, for $(duration)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:agent-keychain</annotate>
  </action>

  <action id="dev.agent-keychain.rule">
    <description>Change which agents get secrets without asking</description>
    <message>"$(caller)" wants to $(change)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:agent-keychain</annotate>
  </action>

  <action id="dev.agent-keychain.write">
    <description>Change a stored secret</description>
    <message>"$(caller)" wants to change the secret "$(secret)"</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.owner">unix-user:agent-keychain</annotate>
  </action>
</policyconfig>
